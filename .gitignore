# ==========================================
# Root .gitignore for CloudVault Platform
# ==========================================

# Eclipse / STS / IDE workspace metadata
.metadata/
.settings/
.project
.classpath
.factorypath
.springBeans
.sts4-cache

# Environment variables & secrets
.env
.env.local
.env.*.local
.env.example

# Build outputs
**/target/
**/build/
**/dist/
**/node_modules/
bin/
tmp/
*.tmp
*.bak
*.swp

# OS generated files
.DS_Store
Thumbs.db
